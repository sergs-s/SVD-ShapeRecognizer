<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>svd.recognizer</groupId>
    <artifactId>SVDShapeRecognizer</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <far.args></far.args>
        <fei.args></fei.args>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-math3</artifactId>
            <version>3.6.1</version>
        </dependency>

        <!-- OpenCV 4.9.0 с модулями contrib (face — Facemark LBF): org.bytedeco (JavaCPP presets), Java-API org.opencv.*;
             нативные библиотеки — Windows и Linux (облачная сессия). Решение Хозяина 12.10.2026 (вместо org.openpnp:opencv). -->
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>opencv</artifactId>
            <version>4.9.0-1.5.10</version>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>opencv</artifactId>
            <version>4.9.0-1.5.10</version>
            <classifier>windows-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>opencv</artifactId>
            <version>4.9.0-1.5.10</version>
            <classifier>linux-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>openblas</artifactId>
            <version>0.3.26-1.5.10</version>
            <classifier>windows-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>openblas</artifactId>
            <version>0.3.26-1.5.10</version>
            <classifier>linux-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
            <version>1.5.10</version>
            <classifier>windows-x86_64</classifier>
        </dependency>
        <dependency>
            <groupId>org.bytedeco</groupId>
            <artifactId>javacpp</artifactId>
            <version>1.5.10</version>
            <classifier>linux-x86_64</classifier>
        </dependency>

        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.27.1</version>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>svd.recognizer.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Оценка на лицах ORL одной командой: mvn compile exec:java@faces-eval -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>faces-eval</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.FaceEvaluation</mainClass>
                        </configuration>
                    </execution>
                    <!-- Кривая FRR от N: mvn compile exec:java@faces-curve -->
                    <execution>
                        <id>faces-curve</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.TrainingSizeCurve</mainClass>
                        </configuration>
                    </execution>
                    <!-- PPCA-скоринг: mvn compile exec:java@faces-ppca -->
                    <execution>
                        <id>faces-ppca</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.PpcaEvaluation</mainClass>
                        </configuration>
                    </execution>
                    <!-- Двумерное правило: mvn compile exec:java@faces-2d -->
                    <execution>
                        <id>faces-2d</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.TwoThresholdEvaluation</mainClass>
                        </configuration>
                    </execution>
                    <!-- Выравнивание лиц и эталон SFace: mvn compile exec:java@faces-align -->
                    <execution>
                        <id>faces-align</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.AlignmentEvaluation</mainClass>
                        </configuration>
                    </execution>
                    <!-- Разбор отказов YuNet: mvn compile exec:java@faces-yunet -->
                    <execution>
                        <id>faces-yunet</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.DetectorDiagnostics</mainClass>
                        </configuration>
                    </execution>
                    <!-- Ручная разметка глаз на своей базе: mvn compile exec:java@faces-eyes
                         (листы проверки: -Dexec.args=sheet) -->
                    <execution>
                        <id>faces-eyes</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.EyeLabeler</mainClass>
                        </configuration>
                    </execution>
                    <!-- Ручная разметка личностей Caltech1999: mvn compile exec:java@faces-caltech
                         (каталог — faces.caltech.dir / FACES_CALTECH_DIR; листы проверки: -Dexec.args=sheet) -->
                    <execution>
                        <id>faces-caltech</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.CaltechLabeler</mainClass>
                        </configuration>
                    </execution>
                    <!-- Порог YuNet на своей базе: mvn compile exec:java@faces-own-yunet -->
                    <execution>
                        <id>faces-own-yunet</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.OwnDetectorThreshold</mainClass>
                        </configuration>
                    </execution>
                    <!-- Отладка DFFS (eigenfaces, eigeneyes) на ORL: mvn compile exec:java@faces-dffs -->
                    <execution>
                        <id>faces-dffs</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.DffsDebug</mainClass>
                        </configuration>
                    </execution>
                    <!-- Отладка каскадов Хаара на ORL: mvn compile exec:java@faces-haar -->
                    <execution>
                        <id>faces-haar</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.HaarDebug</mainClass>
                        </configuration>
                    </execution>
                    <!-- Сравнение способов детекции на своей базе: mvn compile exec:java@faces-own-eval -->
                    <execution>
                        <id>faces-own-eval</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.OwnEvaluation</mainClass>
                        </configuration>
                    </execution>
                    <!-- FAR и FRR на расширенной галерее: mvn compile exec:exec@faces-far
                         (отдельная JVM с пределом памяти -Xmx6g; пересчёт детекций: -Dfar.args=fresh) -->
                    <execution>
                        <id>faces-far</id>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>-Xmx6g</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>svd.recognizer.faces.GalleryEvaluation</argument>
                                <argument>${far.args}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Экспорт выровненных кадров для облака: mvn compile exec:exec@faces-export
                         (каталог — faces.export.dir / FACES_EXPORT_DIR; детекции — кэш faces-far, пересчёт: -Dfar.args=fresh) -->
                    <execution>
                        <id>faces-export</id>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>-Xmx6g</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>svd.recognizer.faces.FarExport</argument>
                                <argument>${far.args}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Шаг 5, SVD: отсечение чужих — mvn compile exec:exec@faces-far-methods
                         (конфигурации — faces.far.methods / FACES_FAR_METHODS; базы — как у faces-far) -->
                    <execution>
                        <id>faces-far-methods</id>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>-Xmx6g</argument>
                                <argument>-Dstdout.encoding=UTF-8</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>svd.recognizer.faces.FarMethods</argument>
                                <argument>${far.args}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Этап 5, протокол «только FEI»: mvn compile exec:exec@faces-fei
                         (данные — экспорт faces.export.dir / FACES_EXPORT_DIR; отладка: -Dfei.args=N — первые N конфигураций) -->
                    <execution>
                        <id>faces-fei</id>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>-Xmx6g</argument>
                                <argument>-Dstdout.encoding=UTF-8</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>svd.recognizer.faces.FeiMethods</argument>
                                <argument>${fei.args}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Этап 5б, разбор файла оценок faces-fei без обучения: mvn compile exec:java@faces-fei-scores
                         (файл — -Dexec.args, по умолчанию reports/faces/fei/fei_scores.tsv.gz; отчёт fei_scores.txt) -->
                    <execution>
                        <id>faces-fei-scores</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.FeiScores</mainClass>
                        </configuration>
                    </execution>
                    <!-- П. 4.2, нормировка оценки по полным векторам (faces.fei.vectors):
                         mvn compile exec:java@faces-fei-norm "-Dexec.args=<каталог векторов> <файл оценок>" (отчёт fei_norm.txt) -->
                    <execution>
                        <id>faces-fei-norm</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.FeiNorm</mainClass>
                        </configuration>
                    </execution>
                    <!-- П. 4.2, LBP против A по полным векторам: mvn compile exec:java@faces-fei-compare
                         "-Dexec.args=<векторы A> <оценки A> <векторы LBP> <оценки LBP>" (отчёт fei_lbp.txt);
                         маски LBP: "-Dexec.args=mask <векторы A> <оценки A> <векторы L> <оценки L> <векторы L1 прежние>"
                         (отчёт fei_lbp_mask.txt) -->
                    <execution>
                        <id>faces-fei-compare</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.FeiCompare</mainClass>
                        </configuration>
                    </execution>
                    <!-- П. 4.2, калибровка порога (П0–П3): mvn compile exec:java@faces-fei-threshold
                         "-Dexec.args=<файл оценок> <файл перекрёстной оценки>" (отчёт fei_threshold.txt) -->
                    <!-- П. 5.5, сверка на других базах: mvn compile exec:java@faces-xbase "-Dexec.args=gt"
                         (контроль пути: "-Dexec.args=fei-check <файл оценок FEI>"); отчёт reports/faces/xbase/ -->
                    <execution>
                        <id>faces-xbase</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.XBaseEval</mainClass>
                        </configuration>
                    </execution>
                    <execution>
                        <id>faces-fei-threshold</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.FeiThreshold</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>