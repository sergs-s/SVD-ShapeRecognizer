<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>svd.recognizer</groupId>
    <artifactId>SVDShapeRecognizer</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-math3</artifactId>
            <version>3.6.1</version>
        </dependency>

        <dependency>
            <groupId>org.openpnp</groupId>
            <artifactId>opencv</artifactId>
            <version>4.9.0-0</version>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>svd.recognizer.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Оценка на лицах ORL одной командой: mvn compile exec:java@faces-eval -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>faces-eval</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.FaceEvaluation</mainClass>
                        </configuration>
                    </execution>
                    <!-- Кривая FRR от N: mvn compile exec:java@faces-curve -->
                    <execution>
                        <id>faces-curve</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.TrainingSizeCurve</mainClass>
                        </configuration>
                    </execution>
                    <!-- PPCA-скоринг: mvn compile exec:java@faces-ppca -->
                    <execution>
                        <id>faces-ppca</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.PpcaEvaluation</mainClass>
                        </configuration>
                    </execution>
                    <!-- Двумерное правило: mvn compile exec:java@faces-2d -->
                    <execution>
                        <id>faces-2d</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.TwoThresholdEvaluation</mainClass>
                        </configuration>
                    </execution>
                    <!-- Выравнивание лиц и эталон SFace: mvn compile exec:java@faces-align -->
                    <execution>
                        <id>faces-align</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.AlignmentEvaluation</mainClass>
                        </configuration>
                    </execution>
                    <!-- Разбор отказов YuNet: mvn compile exec:java@faces-yunet -->
                    <execution>
                        <id>faces-yunet</id>
                        <configuration>
                            <mainClass>svd.recognizer.faces.DetectorDiagnostics</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>